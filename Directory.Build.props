<Project>
  <!-- Shared by every project. The version here is the one Setup, the app and the release notes show;
       the release workflow overrides it from the git tag (vX.Y.Z). -->
  <PropertyGroup>
    <Version>0.9.1</Version>
    <Company>C.A.R.S. Glance contributors</Company>
    <Product>C.A.R.S. Glance</Product>
    <Copyright>Copyright (c) 2026 C.A.R.S. Glance contributors</Copyright>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
