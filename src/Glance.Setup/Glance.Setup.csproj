<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The installer: CarsGlance-Setup.exe. Built on .NET Framework 4.8 (every Windows 10/11 already has it), so it
    runs anywhere. One file: the app (self-contained, so no .NET install is needed) travels inside it as
    payload.zip, and every library Setup uses is embedded and loaded by Embedded.cs. Installs per user: no admin.

    The release build (scripts\build-release.ps1) passes -p:PayloadZip=... -p:PayloadJson=...; a plain build has
    no payload and Setup says so (handy for working on the wizard itself).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CarsGlance-Setup</AssemblyName>
    <RootNamespace>Glance.SetupApp</RootNamespace>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Glance\Assets\glance.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>C.A.R.S. Glance Setup</Product>
    <Description>Installs, updates, repairs and removes C.A.R.S. Glance</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\Glance.Setup.Core\Glance.Setup.Core.csproj" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Resource Include="..\Glance\Assets\glance.png" Link="Assets\glance.png" />
  </ItemGroup>

  <!-- The payload: the app's files (zip) and their hashes (json), embedded by the release build. -->
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)') And Exists('$(PayloadJson)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(PayloadJson)" LogicalName="payload.json" />
  </ItemGroup>

  <!-- Every library Setup needs travels inside the exe as lib/Name.dll (see Embedded.cs). -->
  <Target Name="EmbedLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_LibToEmbed Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <EmbeddedResource Include="@(_LibToEmbed)" LogicalName="lib/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
