<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time helper for scripts\build-release.ps1: packs the app's publish folder into the payload the
       installer embeds, and writes SHA256SUMS.txt. Uses the same code the installer verifies with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Glance.ReleaseTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Glance.Setup.Core\Glance.Setup.Core.csproj" />
  </ItemGroup>
</Project>
